# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
.env.local
.env.*.local

# User uploads (keep directory, ignore uploaded contents)
public/uploads/*
!public/uploads/.gitkeep

# Ignore non-asset binaries, installers, and documents
public/images/*.exe
public/images/*.pdf
public/images/*.ics

# macOS / Windows system files
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/
*.swp
*.swo

